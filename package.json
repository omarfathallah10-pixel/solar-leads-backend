{
  "name": "solar-leads-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "npm run preflight && prisma migrate dev && npm run db:constraints",
    "db:deploy": "npm run preflight && prisma migrate deploy && npm run db:constraints",
    "db:seed": "tsx prisma/seed.ts",
    "status": "tsx scripts/pipelineStatus.ts",
    "db:studio": "prisma studio",
    "db:constraints": "tsx scripts/applyConstraints.ts",
    "db:setup": "npm run preflight && prisma generate && prisma migrate dev --name init && npm run db:constraints && npm run db:seed",
    "doctor": "tsx scripts/doctor.ts",
    "preflight": "tsx scripts/preflight.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "@turf/area": "^7.1.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
