# ---------- Core ----------
NODE_ENV=development
PORT=3000
# '::' binds dual-stack so both 127.0.0.1 and ::1 reach the API. Windows
# resolves `localhost` to ::1 first, so an IPv4-only bind (0.0.0.0) produces
# ECONNREFUSED while the server runs fine. Set 0.0.0.0 only if IPv6 is disabled.
HOST=::
APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Local Postgres (docker compose up -d) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solarleads?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/solarleads?schema=public

# --- Supabase ---
# Copy BOTH strings from Dashboard → Connect. Do NOT use the `db.<ref>.supabase.co`
# direct host: Supabase serves it over IPv6 only unless you buy the IPv4 add-on,
# and most office and home networks are IPv4-only. That is what P1001
# "Can't reach database server" means. Use the pooler host for both.
#
# DATABASE_URL  → Session pooler, port 5432. Chosen over the transaction pooler
#                 (6543) because the approval path uses interactive transactions
#                 and SELECT ... FOR UPDATE, and session mode has no caveats
#                 around either. Switch to 6543 with `?pgbouncer=true` only if
#                 you actually run out of connections.
# DIRECT_URL    → Same host and port. Prisma uses it for migrations.
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase does not provide Redis. BullMQ needs one — run it locally with
# docker compose, or use an Upstash free-tier instance.
REDIS_URL=redis://localhost:6379

SESSION_SECRET=change-me-32-bytes-minimum-please-ok
UNSUBSCRIBE_SECRET=change-me-too-32-bytes-minimum-ok

# ---------- Operations base (used by the serviceability scoring factor) ----------
OPS_BASE_LAT=30.0444
OPS_BASE_LON=31.2357

# ---------- Microsoft Graph (cold outreach from real mailboxes) ----------
# App registration with APPLICATION permissions Mail.Send + Mail.ReadWrite,
# scoped by an ApplicationAccessPolicy to the outreach mailboxes only.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# ---------- Amazon SES (system/transactional mail only) ----------
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=solarleads
SENDING_DOMAIN=outreach.example.com

# ---------- Enrichment providers ----------
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
NASA_POWER_ENDPOINT=https://power.larc.nasa.gov/api/temporal/climatology/point
GOOGLE_MAPS_API_KEY=
HUNTER_API_KEY=
# LLM-based contact extraction from a company's own website, used instead of
# a paid contact-database API (e.g. Apollo). Uses Gemini's free tier, so it
# carries no dollar cost. Left empty, enrichment simply skips this step and
# falls back to the free regex-based website scraper.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------- Budget circuit breaker ----------
MONTHLY_API_BUDGET_USD=50
ENRICHMENT_USER_AGENT=SolarLeads/0.1 (ops@example.com)

# ---------- Sending policy ----------
DEFAULT_MAILBOX_DAILY_CAP=50
MIN_SCORE_FOR_AUTO_APPROVAL=75
